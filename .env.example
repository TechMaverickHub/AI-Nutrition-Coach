# Database connection string for the local/production PostgreSQL instance.
# A plain postgresql:// URL is accepted; the app rewrites it to the asyncpg
# driver internally. Example for a local server:
DATABASE_URL=postgresql://postgres:root@localhost:5432/ai-nutrition-coach

# Application environment: development | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (frontend URLs).
CORS_ORIGINS=http://localhost:5173

# JWT signing secret. Generate a strong value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI. Without a key the AI endpoints respond 503; the rest of the API works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30
